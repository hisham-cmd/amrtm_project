<script>
var TYPE = '{{ $authType }}';
var MODE = '{{ $authMode }}';

var TITLES = {
    'client-login':    ['مرحباً بعودتك',          'أدخل بياناتك للوصول إلى منصة آمر تم'],
    'client-register': ['إنشاء حساب عميل',         'ابدأ رحلتك في إنجاز الخدمات الحكومية'],
    'office-login':    ['دخول المكاتب والشركات',   'أدخل بيانات مكتبك لإدارة الطلبات'],
    'office-register': ['تسجيل مكتب / شركة',       'انضم لمنصة آمر تم كمقدم خدمات'],
};

var FORMS = {
    'client-login':    document.getElementById('f-cl'),
    'client-register': document.getElementById('f-cr'),
    'office-login':    document.getElementById('f-ol'),
    'office-register': document.getElementById('f-or'),
};

function switchType(t) { TYPE = t; updateUI(); }
function switchMode(m) { MODE = m; updateUI(); }

function updateUI() {
    var key = TYPE + '-' + MODE;

    document.getElementById('tc-client').classList.toggle('active', TYPE === 'client');
    document.getElementById('tc-office').classList.toggle('active', TYPE === 'office');
    document.getElementById('tab-login').classList.toggle('active',    MODE === 'login');
    document.getElementById('tab-register').classList.toggle('active', MODE === 'register');

    var t = TITLES[key] || ['', ''];
    document.getElementById('form-title').textContent = t[0];
    document.getElementById('form-sub').textContent   = t[1];

    for (var k in FORMS) {
        if (FORMS[k]) FORMS[k].style.display = (k === key) ? '' : 'none';
    }
}

function togglePw(inputId, iconId) {
    var input = document.getElementById(inputId);
    var icon  = document.getElementById(iconId);
    if (!input || !icon) return;
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
    } else {
        input.type = 'password';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
    }
}

updateUI();
</script>

</body>
